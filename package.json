{
  "name": "dshdeck",
  "version": "0.1.1",
  "private": true,
  "description": "DshDeck 多服务器 dsh 会话工作台",
  "type": "module",
  "main": "dist/src/main/app.js",
  "engines": { "node": ">=24.10.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/build-renderer.mjs",
    "build:release": "tsc -p tsconfig.release.json && node tools/build-renderer.mjs",
    "package:win": "npm run build:release && electron-builder --config electron-builder.json --win --x64 --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "start:poc": "electron . --poc",
    "test": "node --test \"dist/tests/*.test.js\""
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/ws": "8.18.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "electron": "45.3.2",
    "electron-builder": "26.0.12",
    "typescript": "5.9.3"
  }
}
